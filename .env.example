# LiveKit Cloud project (Settings → API keys). Agents and the judge use LiveKit Inference, so no other keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional
# SIMS_MAX_CONCURRENT_CALLS=4   # simulations running at once, across all workers
# SIMS_MAX_QUEUED_RUNS=50       # a start that would exceed this is refused whole
